#!/usr/bin/env bash
set -euo pipefail

DIR="${WALLPAPER_DIR:-$HOME/Изображения/Wallpaper}"
STATE="${WALLPAPER_STATE:-$HOME/.cache/wallpaper_index}"
THUMB_DIR="${WALLPAPER_THUMB_DIR:-$HOME/.cache/wallpaper-picker}"

COLUMNS=4
IMAGE_SIZE=210
THUMB_WIDTH=420
THUMB_HEIGHT=260
THUMB_RADIUS=18
THUMB_VERSION="rounded-v1"

mkdir -p "$THUMB_DIR"

# Must stay identical to the enumeration in wallpaper-next / wallpaper-prev
# (see the comment there): symlinks followed, same extensions, byte-order
# sort — the index written to $STATE is read back by them and by the Qt app.
mapfile -t FILES < <(
    find -L "$DIR" -maxdepth 1 -type f \
        \( -iname '*.jpg' -o -iname '*.jpeg' -o -iname '*.png' \
        -o -iname '*.webp' -o -iname '*.bmp' \) 2>/dev/null |
        LC_ALL=C sort
)

COUNT=${#FILES[@]}

[ "$COUNT" -eq 0 ] && exit 1

ENTRIES=""
DISPLAYED_FILES=()

for file in "${FILES[@]}"; do
    name="$(basename "$file")"

    hash="$(
        printf '%s\0%s' "$file" "$THUMB_VERSION" |
            sha256sum |
            cut -d' ' -f1
    )"

    thumb="$THUMB_DIR/$hash.png"

    if [ ! -f "$thumb" ] || [ "$file" -nt "$thumb" ]; then
        if ! magick "$file" \
            -thumbnail "${THUMB_WIDTH}x${THUMB_HEIGHT}^" \
            -gravity center \
            -extent "${THUMB_WIDTH}x${THUMB_HEIGHT}" \
            \( -size "${THUMB_WIDTH}x${THUMB_HEIGHT}" xc:none \
                -fill white \
                -draw "roundrectangle 0,0,$((THUMB_WIDTH - 1)),$((THUMB_HEIGHT - 1)),$THUMB_RADIUS,$THUMB_RADIUS" \
            \) \
            -alpha set \
            -compose DstIn \
            -composite \
            "$thumb" 2>/dev/null; then

            rm -f "$thumb"
            continue
        fi
    fi

    DISPLAYED_FILES+=("$file")

    ENTRIES+="img:${thumb}:text:${name}\n"
done

[ "${#DISPLAYED_FILES[@]}" -eq 0 ] && exit 1

SELECTED_INDEX=$(
    printf '%b' "$ENTRIES" |
        wofi \
            --dmenu \
            --allow-images \
            --insensitive \
            --width 40% \
            --height 60% \
            --columns "$COLUMNS" \
            --define image_size="$IMAGE_SIZE" \
            --define content_halign=center \
            --define dmenu-print_line_num=true \
            --style "$HOME/.config/wofi/wallpaper.css"
)

[ -z "$SELECTED_INDEX" ] && exit 0

# wofi's `dmenu-print_line_num` prints the *0-based* index of the selected line
# (modes/dmenu.c: `uint16_t line_num = 0; ... snprintf(action, 6, "%u", line_num++)`,
# iterating the entries in the order they were fed in). Subtracting 1 here
# applied the image *above* the clicked one and made the first image a no-op.
# Anything non-numeric (a custom entry typed into wofi) is not a position.
case "$SELECTED_INDEX" in
    *[!0-9]*) exit 1 ;;
esac

SELECTED_FILE="${DISPLAYED_FILES[$SELECTED_INDEX]:-}"

[ -z "$SELECTED_FILE" ] && exit 1

mkdir -p "$(dirname "$STATE")"
for i in "${!FILES[@]}"; do
    if [ "${FILES[$i]}" = "$SELECTED_FILE" ]; then
        echo "$i" > "$STATE"
        break
    fi
done

if [ -n "${WALLPAPER_DRY_RUN:-}" ]; then
    # Test/debug hook: report the chosen file instead of applying it.
    printf '%s\n' "$SELECTED_FILE"
else
    plasma-apply-wallpaperimage "$SELECTED_FILE"
fi
