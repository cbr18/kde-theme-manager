#!/usr/bin/env python3
import colorsys
import os
import signal
import subprocess
import sys
import time

try:
    import dbus
except ImportError:
    dbus = None


HYPERION_REMOTE = os.environ.get(
    "HYPERION_REMOTE",
    "/home/cbr/.local/opt/hyperion/bin/hyperion-remote",
)
HYPERION_ADDRESS = os.environ.get("HYPERION_ADDRESS", "127.0.0.1:19444")
HYPERION_PRIORITY = os.environ.get("HYPERION_PRIORITY", "50")
OPENRGB_BIN = os.environ.get("OPENRGB_BIN", "/usr/bin/openrgb")
OPENRGB_CLIENT = os.environ.get("OPENRGB_CLIENT", "")
OPENRGB_DEVICE = os.environ.get("OPENRGB_DEVICE", "0")
INTERVAL_SECONDS = float(os.environ.get("RGB_SYNC_INTERVAL", "1.0"))
CYCLE_SECONDS = float(os.environ.get("RGB_SYNC_CYCLE", "18.0"))
SATURATION = float(os.environ.get("RGB_SYNC_SATURATION", "1.0"))
VALUE = float(os.environ.get("RGB_SYNC_VALUE", "1.0"))
RAZER_SERVICE = "org.razer"

running = True


def stop(_signum, _frame):
    global running
    running = False


def clamp(value, low=0.0, high=1.0):
    return max(low, min(high, value))


def current_hex(now):
    hue = (now % CYCLE_SECONDS) / CYCLE_SECONDS
    red, green, blue = colorsys.hsv_to_rgb(hue, clamp(SATURATION), clamp(VALUE))
    return f"{round(red * 255):02X}{round(green * 255):02X}{round(blue * 255):02X}"


def hex_to_rgb(color):
    return int(color[0:2], 16), int(color[2:4], 16), int(color[4:6], 16)


def run_quiet(command, timeout):
    return subprocess.run(
        command,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        timeout=timeout,
        check=False,
    ).returncode


def set_hyperion(color):
    return run_quiet(
        [
            HYPERION_REMOTE,
            "--address",
            HYPERION_ADDRESS,
            "--priority",
            HYPERION_PRIORITY,
            "--duration",
            "3000",
            "--color",
            color,
        ],
        2.0,
    )


def set_openrgb(color):
    command = [OPENRGB_BIN]
    if OPENRGB_CLIENT:
        command.extend(["--client", OPENRGB_CLIENT])
    command.extend(["--device", OPENRGB_DEVICE, "--mode", "Direct", "--color", color])
    return run_quiet(command, 8.0)


class OpenRazerBackend:
    def __init__(self):
        if dbus is None:
            raise RuntimeError("python-dbus is not available")

        bus = dbus.SessionBus()
        daemon_object = bus.get_object(RAZER_SERVICE, "/org/razer")
        devices = dbus.Interface(daemon_object, "razer.devices")
        serials = list(devices.getDevices())
        if not serials:
            raise RuntimeError("OpenRazer reports no devices")

        self._calls = []
        for serial in serials:
            path = f"/org/razer/device/{serial}"
            device = bus.get_object(RAZER_SERVICE, path)

            # Cobra Pro exposes partial zone support. Try all-device first,
            # then explicit logo and scroll wheel zones.
            self._calls.extend(
                [
                    dbus.Interface(device, "razer.device.lighting.chroma").setStatic,
                    dbus.Interface(device, "razer.device.lighting.logo").setLogoStatic,
                    dbus.Interface(device, "razer.device.lighting.scroll").setScrollStatic,
                ]
            )

    def set_color(self, color):
        red, green, blue = hex_to_rgb(color)
        ok = False
        errors = []
        for call in self._calls:
            try:
                call(red, green, blue)
                ok = True
            except dbus.DBusException as exc:
                errors.append(exc.get_dbus_message())
        if not ok:
            raise RuntimeError("; ".join(errors) or "OpenRazer color update failed")


def main():
    signal.signal(signal.SIGINT, stop)
    signal.signal(signal.SIGTERM, stop)

    last_color = None
    failures = 0
    razer = None

    while running:
        color = current_hex(time.time())
        if color != last_color:
            if razer is None:
                try:
                    razer = OpenRazerBackend()
                except Exception as exc:
                    failures += 1
                    print(
                        f"rgb-hyperion-sync: OpenRazer unavailable: {exc}",
                        file=sys.stderr,
                        flush=True,
                    )
                    time.sleep(5)
                    continue

            hyperion_rc = set_hyperion(color)
            try:
                razer.set_color(color)
                razer_ok = True
            except Exception as exc:
                razer = None
                razer_ok = False
                print(
                    f"rgb-hyperion-sync: OpenRazer color update failed: {exc}",
                    file=sys.stderr,
                    flush=True,
                )

            if hyperion_rc != 0 or not razer_ok:
                failures += 1
                print(
                    f"rgb-hyperion-sync: color={color} hyperion_rc={hyperion_rc} razer_ok={razer_ok}",
                    file=sys.stderr,
                    flush=True,
                )
            else:
                failures = 0
                last_color = color

            if failures >= 10:
                time.sleep(5)
                failures = 0

        time.sleep(INTERVAL_SECONDS)

    run_quiet([HYPERION_REMOTE, "--address", HYPERION_ADDRESS, "--priority", HYPERION_PRIORITY, "--clear"], 2.0)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
