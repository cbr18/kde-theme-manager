#!/usr/bin/env bash
set -euo pipefail

ROOT="$HOME/.config/theme-profile"
PROFILES="$ROOT/profiles"
BACKUPS="$ROOT/backups"
MANIFESTS="$ROOT/manifests"
ACTIVE_FILE="$ROOT/active-profile"

TRACKED_PATHS=(
  ".config/kwinrc"
  ".config/kwinrulesrc"
  ".config/kdeglobals"
  ".config/plasmarc"
  ".config/plasma-org.kde.plasma.desktop-appletsrc"
  ".config/plasmashellrc"
  ".config/gtk-3.0/settings.ini"
  ".config/gtk-3.0/gtk.css"
  ".config/gtk-3.0/colors.css"
  ".config/gtk-4.0/settings.ini"
  ".config/gtk-4.0/gtk.css"
  ".config/gtk-4.0/colors.css"
  ".config/QtProject.conf"
  ".config/Trolltech.conf"
  ".config/klassy/klassyrc"
  ".config/klassy/windecopresetsrc"
  ".config/Kvantum/kvantum.kvconfig"
  ".config/Kvantum/Sandstone"
  ".config/alacritty/alacritty.toml"
  ".config/alacritty/themes/noctalia.toml"
  ".config/kitty/kitty.conf"
  ".config/wofi/style.css"
  ".config/wofi/wallpaper.css"
  ".config/btop/btop.conf"
  ".config/btop/themes/noctalia.theme"
  ".config/btop/themes/paper.theme"
  ".config/fastfetch/config.jsonc"
  ".config/fastfetch/logo"
  ".config/fastfetch/cat-source.jpg"
  ".config/zed/settings.json"
  ".config/zed/themes"
  ".zen/gp0y8wrv.Default (release)/user.js"
  ".zen/gp0y8wrv.Default (release)/chrome/userChrome.css"
  ".zen/gp0y8wrv.Default (release)/chrome/userContent.css"
  ".zen/gp0y8wrv.Default (release)/chrome/zen-themes.css"
  ".config/Code/User/settings.json"
  ".config/Cursor/User/settings.json"
  ".config/obsidian/obsidian.json"
  ".config/obsidian/Preferences"
  "obsidian/vault/.obsidian/appearance.json"
  ".local/share/color-schemes/ThemeProfilePaper.colors"
  ".local/share/plasma/look-and-feel/glass"
  ".local/share/plasma/look-and-feel/paper"
)

mkdir -p "$PROFILES" "$BACKUPS" "$MANIFESTS"

usage() {
  cat <<'USAGE'
Usage:
  theme-profile status
  theme-profile list
  theme-profile save NAME
  theme-profile apply NAME
  theme-profile diff A B

Profiles live in ~/.config/theme-profile/profiles.
USAGE
}

copy_tracked_into() {
  local target="$1"
  mkdir -p "$target"

  local rel src dst
  for rel in "${TRACKED_PATHS[@]}"; do
    src="$HOME/$rel"
    [ -e "$src" ] || continue
    dst="$target/$rel"
    mkdir -p "$(dirname "$dst")"
    if [ -e "$dst" ] || [ -L "$dst" ]; then
      rm -rf "$dst"
    fi
    cp -a "$src" "$dst"
  done
}

write_ini_group() {
  local file="$1"
  local group="$2"
  awk -v group="$group" '
    $0 == "[" group "]" { in_group=1; next }
    in_group && /^\[/ { exit }
    in_group { print }
  ' "$file" 2>/dev/null || true
}

capture_kde_effects_state() {
  local target="$1"
  local meta="$target/metadata/kde"
  local notification_server
  local kwin_support
  local kwin_active_effects
  local kwin_loaded_effects
  mkdir -p "$meta"

  notification_server="$(qdbus6 org.freedesktop.Notifications /org/freedesktop/Notifications org.freedesktop.Notifications.GetServerInformation 2>/dev/null || busctl --user call org.freedesktop.Notifications /org/freedesktop/Notifications org.freedesktop.Notifications GetServerInformation 2>/dev/null || true)"
  kwin_support="$(qdbus6 org.kde.KWin /KWin supportInformation 2>/dev/null || busctl --user call org.kde.KWin /KWin org.kde.KWin supportInformation 2>/dev/null || true)"
  kwin_active_effects="$(qdbus6 org.kde.KWin /Effects activeEffects 2>/dev/null || busctl --user call org.kde.KWin /Effects org.kde.kwin.Effects activeEffects 2>/dev/null || true)"
  kwin_loaded_effects="$(qdbus6 org.kde.KWin /Effects loadedEffects 2>/dev/null || busctl --user call org.kde.KWin /Effects org.kde.kwin.Effects loadedEffects 2>/dev/null || true)"

  {
    echo "Generated by theme-profile"
    echo "timestamp=$(date --iso-8601=seconds)"
    echo
    echo "[kwinrc: Plugins]"
    kreadconfig6 --file kwinrc --group Plugins --key glassEnabled 2>/dev/null | sed 's/^/glassEnabled=/' || true
    kreadconfig6 --file kwinrc --group Plugins --key blurEnabled 2>/dev/null | sed 's/^/blurEnabled=/' || true
    kreadconfig6 --file kwinrc --group Plugins --key better_blur_dxEnabled 2>/dev/null | sed 's/^/better_blur_dxEnabled=/' || true
    kreadconfig6 --file kwinrc --group Plugins --key contrastEnabled 2>/dev/null | sed 's/^/contrastEnabled=/' || true
    kreadconfig6 --file kwinrc --group Plugins --key translucencyEnabled 2>/dev/null | sed 's/^/translucencyEnabled=/' || true
    echo
    echo "[notification-server]"
    printf '%s\n' "$notification_server"
    echo
    echo "[kwin-dbus-active-effects]"
    printf '%s\n' "$kwin_active_effects"
    echo
    echo "[kwin-dbus-loaded-effects]"
    printf '%s\n' "$kwin_loaded_effects"
  } > "$meta/summary.txt"

  printf '%s\n' "$kwin_support" > "$meta/kwin-support-information.txt"
  kreadconfig6 --file kwinrc --group Plugins > "$meta/kwin-plugins.txt" 2>/dev/null || true

  {
    echo "[Effect-blur]"
    write_ini_group "$HOME/.config/kwinrc" "Effect-blur"
    echo
    echo "[Effect-blurplus]"
    write_ini_group "$HOME/.config/kwinrc" "Effect-blurplus"
    echo
    echo "[Effect-better-blur-dx]"
    write_ini_group "$HOME/.config/kwinrc" "Effect-better-blur-dx"
    echo
    echo "[Effect-translucency]"
    write_ini_group "$HOME/.config/kwinrc" "Effect-translucency"
  } > "$meta/glass-and-blur-config.txt"
}

restore_from_profile() {
  local profile="$1"
  local source="$PROFILES/$profile"
  [ -d "$source" ] || {
    echo "Profile not found: $profile" >&2
    exit 1
  }

  local rel src dst
  for rel in "${TRACKED_PATHS[@]}"; do
    src="$source/$rel"
    [ -e "$src" ] || continue
    dst="$HOME/$rel"
    mkdir -p "$(dirname "$dst")"
    if [ -d "$src" ]; then
      mkdir -p "$dst"
      cp -a "$src/." "$dst/"
    else
      cp -a "$src" "$dst"
    fi
  done

  printf '%s\n' "$profile" > "$ACTIVE_FILE"
}

apply_live_hooks() {
  local profile="$1"
  local source="$PROFILES/$profile"
  local look_and_feel

  look_and_feel="$(kreadconfig6 --file kdeglobals --group KDE --key LookAndFeelPackage "$source/.config/kdeglobals" 2>/dev/null || true)"
  if [ -n "$look_and_feel" ]; then
    kwriteconfig6 --file kdeglobals --group KDE --key LookAndFeelPackage "$look_and_feel" >/dev/null 2>&1 || true
  fi

  kbuildsycoca6 >/dev/null 2>&1 || true
  systemctl --user stop swaync.service >/dev/null 2>&1 || true
  qdbus6 org.kde.KWin /KWin reconfigure >/dev/null 2>&1 || true
  sync_kwin_effect "$source" glass
  sync_kwin_effect "$source" blur
  sync_kwin_effect "$source" contrast
  sync_kwin_effect "$source" better_blur_dx
  reconfigure_kwin_effect glass
  reconfigure_kwin_effect blur
  reconfigure_kwin_effect contrast
  reconfigure_kwin_effect better_blur_dx
  apply_kitty_live "$source"
  start_plasma_shell
}

reconfigure_kwin_effect() {
  qdbus6 org.kde.KWin /Effects reconfigureEffect "$1" >/dev/null 2>&1 || true
}

apply_kitty_live() {
  local source="$1"
  local config="$source/.config/kitty/kitty.conf"
  local opacity

  [ -f "$config" ] || return 0
  command -v kitty >/dev/null 2>&1 || return 0

  kitty @ --to unix:/tmp/kitty-theme-profile load-config "$config" >/dev/null 2>&1 || true

  opacity="$(awk '$1 == "background_opacity" { print $2; exit }' "$config" 2>/dev/null || true)"
  if [ -n "$opacity" ]; then
    kitty @ --to unix:/tmp/kitty-theme-profile set-background-opacity --all "$opacity" >/dev/null 2>&1 || true
  fi

  kitty @ --to unix:/tmp/kitty-theme-profile set-colors --all --configured "$config" >/dev/null 2>&1 || true
}

kwin_effect_key() {
  local group="$1"
  local key="$2"

  kreadconfig6 --file kwinrc --group "$group" --key "$key" 2>/dev/null | paste -sd, - || true
}

zen_user_pref() {
  local key="$1"
  local file="$HOME/.zen/gp0y8wrv.Default (release)/user.js"

  awk -v key="$key" '
    index($0, "user_pref(\"" key "\",") == 1 {
      value=$0
      sub("^user_pref\\(\"" key "\",[[:space:]]*", "", value)
      sub("\\);$", "", value)
      gsub(/^"|"$/, "", value)
      print value
      exit
    }
  ' "$file" 2>/dev/null || true
}

stop_plasma_shell_for_restore() {
  systemctl --user reset-failed plasma-plasmashell.service >/dev/null 2>&1 || true
  systemctl --user stop plasma-plasmashell.service >/dev/null 2>&1 || true
}

start_plasma_shell() {
  systemctl --user reset-failed plasma-plasmashell.service >/dev/null 2>&1 || true
  systemctl --user start plasma-plasmashell.service >/dev/null 2>&1 || true
  sleep 1
  if ! systemctl --user is-active --quiet plasma-plasmashell.service; then
    systemctl --user reset-failed plasma-plasmashell.service >/dev/null 2>&1 || true
    systemctl --user start plasma-plasmashell.service >/dev/null 2>&1 || true
  fi
}

sync_kwin_effect() {
  local source="$1"
  local effect="$2"
  local key="${effect}Enabled"
  local enabled

  enabled="$(awk -F= -v key="$key" '
    $0 == "[Plugins]" { in_group=1; next }
    in_group && /^\[/ { exit }
    in_group && $1 == key { print $2; exit }
  ' "$source/.config/kwinrc" 2>/dev/null || true)"

  case "$enabled" in
    true)
      qdbus6 org.kde.KWin /Effects loadEffect "$effect" >/dev/null 2>&1 || true
      ;;
    false)
      qdbus6 org.kde.KWin /Effects unloadEffect "$effect" >/dev/null 2>&1 || true
      ;;
  esac
}

write_manifest() {
  local target="$1"
  {
    echo "Generated by theme-profile"
    echo "timestamp=$(date --iso-8601=seconds)"
    echo "user=$USER"
    echo
    echo "[tracked]"
    printf '%s\n' "${TRACKED_PATHS[@]}"
  } > "$target/manifest.txt"
}

status() {
  echo "active_profile=$(cat "$ACTIVE_FILE" 2>/dev/null || echo unknown)"
  echo "kde_color_scheme=$(kreadconfig6 --file kdeglobals --group General --key ColorScheme 2>/dev/null || true)"
  echo "kde_accent=$(kreadconfig6 --file kdeglobals --group General --key AccentColor 2>/dev/null || true)"
  echo "kde_look_and_feel=$(kreadconfig6 --file kdeglobals --group KDE --key LookAndFeelPackage 2>/dev/null || true)"
  echo "kde_widget_style=$(kreadconfig6 --file kdeglobals --group KDE --key widgetStyle 2>/dev/null || true)"
  echo "kwin_glass=$(kreadconfig6 --file kwinrc --group Plugins --key glassEnabled 2>/dev/null || true)"
  echo "kwin_blur=$(kreadconfig6 --file kwinrc --group Plugins --key blurEnabled 2>/dev/null || true)"
  echo "kwin_contrast=$(kreadconfig6 --file kwinrc --group Plugins --key contrastEnabled 2>/dev/null || true)"
  echo "kwin_better_blur_dx=$(kreadconfig6 --file kwinrc --group Plugins --key better_blur_dxEnabled 2>/dev/null || true)"
  echo "bbdx_blur_strength=$(kwin_effect_key Effect-better-blur-dx BlurStrength)"
  echo "bbdx_contrast=$(kwin_effect_key Effect-better-blur-dx Contrast)"
  echo "bbdx_blur_decorations=$(kwin_effect_key Effect-better-blur-dx BlurDecorations)"
  echo "bbdx_blur_docks=$(kwin_effect_key Effect-better-blur-dx BlurDocks)"
  echo "bbdx_blur_menus=$(kwin_effect_key Effect-better-blur-dx BlurMenus)"
  echo "bbdx_refraction_strength=$(kwin_effect_key Effect-better-blur-dx RefractionStrength)"
  echo "bbdx_refraction_edge_size=$(kwin_effect_key Effect-better-blur-dx RefractionEdgeSize)"
  echo "bbdx_refraction_normal_pow=$(kwin_effect_key Effect-better-blur-dx RefractionNormalPow)"
  echo "bbdx_window_classes=$(kwin_effect_key Effect-better-blur-dx WindowClasses)"
  echo "kwin_translucency_inactive=$(kreadconfig6 --file kwinrc --group Effect-translucency --key Inactive 2>/dev/null || true)"
  echo "kvantum_theme=$(sed -n 's/^theme=//p' "$HOME/.config/Kvantum/kvantum.kvconfig" 2>/dev/null || true)"
  echo "gtk3_theme=$(sed -n 's/^gtk-theme-name=//p' "$HOME/.config/gtk-3.0/settings.ini" 2>/dev/null || true)"
  echo "gtk3_prefer_dark=$(sed -n 's/^gtk-application-prefer-dark-theme=//p' "$HOME/.config/gtk-3.0/settings.ini" 2>/dev/null || true)"
  echo "klassy_titlebar_active_opacity=$(kreadconfig6 --file "$HOME/.config/klassy/klassyrc" --group TitleBarOpacity --key ActiveTitleBarOpacity 2>/dev/null || true)"
  echo "klassy_titlebar_inactive_opacity=$(kreadconfig6 --file "$HOME/.config/klassy/klassyrc" --group TitleBarOpacity --key InactiveTitleBarOpacity 2>/dev/null || true)"
  echo "klassy_corner_radius=$(kreadconfig6 --file "$HOME/.config/klassy/klassyrc" --group Windeco --key WindowCornerRadius 2>/dev/null || true)"
  echo "alacritty_opacity=$(sed -n 's/^opacity = //p' "$HOME/.config/alacritty/alacritty.toml" 2>/dev/null || true)"
  echo "alacritty_blur=$(sed -n 's/^blur = //p' "$HOME/.config/alacritty/alacritty.toml" 2>/dev/null || true)"
  echo "kitty_background_opacity=$(sed -n 's/^background_opacity //p' "$HOME/.config/kitty/kitty.conf" 2>/dev/null || true)"
  echo "kitty_background_blur=$(sed -n 's/^background_blur //p' "$HOME/.config/kitty/kitty.conf" 2>/dev/null || true)"
  echo "zen_transparent_browser=$(zen_user_pref browser.tabs.allow_transparent_browser)"
  echo "zen_linux_transparency=$(zen_user_pref zen.widget.linux.transparency)"
  echo "zen_custom_stylesheets=$(zen_user_pref toolkit.legacyUserProfileCustomizations.stylesheets)"
  echo "zen_active_theme=$(zen_user_pref extensions.activeThemeID)"
  echo "zen_content_theme=$(zen_user_pref browser.theme.content-theme)"
  echo "zen_toolbar_theme=$(zen_user_pref browser.theme.toolbar-theme)"
  echo "zen_transparency_color=$(zen_user_pref mod.sameerasw.zen_transparency_color)"
  echo "zen_bg_color_enabled=$(zen_user_pref mod.sameerasw.zen_bg_color_enabled)"
  echo "zen_bg_opacity=$(zen_user_pref mod.sameerasw.zen_bg_opacity)"
  echo "btop_rounded_corners=$(sed -n 's/^rounded_corners = //p' "$HOME/.config/btop/btop.conf" 2>/dev/null || true)"
  echo "zed_theme_mode=$(awk '/^[[:space:]]*"theme"[[:space:]]*:/ { in_theme=1; next } in_theme && /^[[:space:]]*"mode"[[:space:]]*:/ { sub(/^[[:space:]]*/, ""); print; exit }' "$HOME/.config/zed/settings.json" 2>/dev/null || true)"
  echo "zed_theme_light=$(awk '/^[[:space:]]*"theme"[[:space:]]*:/ { in_theme=1; next } in_theme && /^[[:space:]]*"light"[[:space:]]*:/ { sub(/^[[:space:]]*/, ""); print; exit }' "$HOME/.config/zed/settings.json" 2>/dev/null || true)"
  echo "zed_theme_dark=$(awk '/^[[:space:]]*"theme"[[:space:]]*:/ { in_theme=1; next } in_theme && /^[[:space:]]*"dark"[[:space:]]*:/ { sub(/^[[:space:]]*/, ""); print; exit }' "$HOME/.config/zed/settings.json" 2>/dev/null || true)"
  echo "code_theme=$(rg -n 'workbench.colorTheme' "$HOME/.config/Code/User/settings.json" 2>/dev/null | head -1 | sed 's/^[^:]*:[[:space:]]*//')"
  echo "cursor_theme=$(rg -n 'workbench.colorTheme' "$HOME/.config/Cursor/User/settings.json" 2>/dev/null | head -1 | sed 's/^[^:]*:[[:space:]]*//')"
  echo "obsidian_appearance=$(tr -d '\n' < "$HOME/obsidian/vault/.obsidian/appearance.json" 2>/dev/null || true)"
}

cmd="${1:-}"
case "$cmd" in
  status)
    status
    ;;
  list)
    find "$PROFILES" -mindepth 1 -maxdepth 1 -type d -printf '%f\n' | sort
    ;;
  save)
    name="${2:-}"
    [ -n "$name" ] || {
      usage >&2
      exit 1
    }
    case "$name" in
      *[!A-Za-z0-9._-]*) echo "Invalid profile name: $name (allowed: A-Za-z0-9._-)" >&2; exit 1 ;;
    esac
    target="$PROFILES/$name"
    mkdir -p "$target"
    copy_tracked_into "$target"
    capture_kde_effects_state "$target"
    write_manifest "$target"
    printf '%s\n' "$name" > "$ACTIVE_FILE"
    echo "Saved profile: $name"
    ;;
  apply)
    name="${2:-}"
    [ -n "$name" ] || {
      usage >&2
      exit 1
    }
    case "$name" in
      *[!A-Za-z0-9._-]*) echo "Invalid profile name: $name (allowed: A-Za-z0-9._-)" >&2; exit 1 ;;
    esac
    # ВАЖНО: проверяем профиль ДО остановки plasma
    [ -d "$PROFILES/$name" ] || { echo "Profile not found: $name" >&2; exit 1; }
    ts="$(date +%Y%m%d-%H%M%S)"
    backup="$BACKUPS/pre-apply-$name-$ts"
    copy_tracked_into "$backup"
    capture_kde_effects_state "$backup"
    write_manifest "$backup"
    # trap: если что-то упадёт после остановки — вернём plasma
    trap 'start_plasma_shell' ERR
    stop_plasma_shell_for_restore
    if restore_from_profile "$name"; then
      apply_live_hooks "$name"
      trap - ERR
      echo "Applied profile: $name"
      echo "Pre-apply backup: $backup"
    else
      start_plasma_shell
      trap - ERR
      echo "Failed to apply profile: $name — plasma shell started, pre-apply backup: $backup" >&2
      exit 1
    fi
    ;;
  diff)
    a="${2:-}"
    b="${3:-}"
    [ -n "$a" ] && [ -n "$b" ] || {
      usage >&2
      exit 1
    }
    [ -d "$PROFILES/$a" ] || { echo "Profile not found: $a" >&2; exit 1; }
    [ -d "$PROFILES/$b" ] || { echo "Profile not found: $b" >&2; exit 1; }
    diff -ru "$PROFILES/$a" "$PROFILES/$b"; rc=$?
    if [ "$rc" -eq 1 ]; then
      # differences found — this is normal
      exit 0
    elif [ "$rc" -ne 0 ]; then
      exit "$rc"
    fi
    ;;
  --help|-h)
    usage
    exit 0
    ;;
  *)
    usage
    exit 1
    ;;
esac
