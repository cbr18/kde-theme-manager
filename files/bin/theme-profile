#!/usr/bin/env bash
set -euo pipefail

CONFIG_HOME="${XDG_CONFIG_HOME:-${HOME}/.config}"
DATA_HOME="${XDG_DATA_HOME:-${HOME}/.local/share}"
CACHE_HOME="${XDG_CACHE_HOME:-${HOME}/.cache}"
ROOT="$CONFIG_HOME/theme-profile"
# Keep using the pre-XDG location when it already exists (compatibility).
if [ ! -d "$ROOT" ] && [ -n "${XDG_CONFIG_HOME:-}" ] && [ -d "${HOME}/.config/theme-profile" ]; then
  ROOT="${HOME}/.config/theme-profile"
fi

# Resolve a profile-relative path for live files.  Profiles keep the historical
# .config/.local/share layout, but live files must follow XDG variables.
live_path() {
  local rel="$1"
  case "$rel" in
    .config/*) printf '%s/%s\n' "$CONFIG_HOME" "${rel#.config/}" ;;
    .local/share/*) printf '%s/%s\n' "$DATA_HOME" "${rel#.local/share/}" ;;
    .cache/*) printf '%s/%s\n' "$CACHE_HOME" "${rel#.cache/}" ;;
    *) printf '%s/%s\n' "$HOME" "$rel" ;;
  esac
}
PROFILES="$ROOT/profiles"
BACKUPS="$ROOT/backups"
MANIFESTS="$ROOT/manifests"
ACTIVE_FILE="$ROOT/active-profile"

# Component → path prefixes mapping (for --components filtering)
# Keys match TrackedAppDef.id from the Bash core
# Paths are colon-separated (no colons in paths)
declare -A COMPONENT_PATHS=(
  [kwin]=".config/kwinrc:.config/kwinrulesrc"
  [plasma_shell]=".config/plasmarc:.config/plasmashellrc:.config/plasma-org.kde.plasma.desktop-appletsrc"
  [kdeglobals]=".config/kdeglobals"
  [gtk3]=".config/gtk-3.0/settings.ini:.config/gtk-3.0/gtk.css:.config/gtk-3.0/colors.css"
  [gtk4]=".config/gtk-4.0/settings.ini:.config/gtk-4.0/gtk.css:.config/gtk-4.0/colors.css"
  [qt5ct]=".config/QtProject.conf:.config/Trolltech.conf"
  [klassy]=".config/klassy/klassyrc:.config/klassy/windecopresetsrc"
  [kvantum]=".config/Kvantum/kvantum.kvconfig:.config/Kvantum/Sandstone"
  [alacritty]=".config/alacritty/alacritty.toml:.config/alacritty/themes/noctalia.toml"
  [kitty]=".config/kitty/kitty.conf"
  [wofi]=".config/wofi/style.css:.config/wofi/wallpaper.css"
  [btop]=".config/btop/btop.conf:.config/btop/themes/noctalia.theme:.config/btop/themes/paper.theme"
  [fastfetch]=".config/fastfetch/config.jsonc:.config/fastfetch/logo:.config/fastfetch/cat-source.jpg"
  [zed]=".config/zed/settings.json:.config/zed/themes"
  [vscode]=".config/Code/User/settings.json"
  [cursor]=".config/Cursor/User/settings.json"
  [zen]=".zen/gp0y8wrv.Default (release)/user.js:.zen/gp0y8wrv.Default (release)/chrome/userChrome.css:.zen/gp0y8wrv.Default (release)/chrome/userContent.css:.zen/gp0y8wrv.Default (release)/chrome/zen-themes.css"
  [obsidian]=".config/obsidian/obsidian.json:.config/obsidian/Preferences:obsidian/vault/.obsidian/appearance.json"
  [color_schemes]=".local/share/color-schemes/ThemeProfilePaper.colors"
  [look_and_feel]=".local/share/plasma/look-and-feel/glass:.local/share/plasma/look-and-feel/paper"
)

# Build TRACKED_PATHS from all components (default: all)
build_tracked_paths() {
  local components_str="${1:-}"
  TRACKED_PATHS=()

  if [ -z "$components_str" ] || [ "$components_str" = "all" ]; then
    # All components
    for comp in "${!COMPONENT_PATHS[@]}"; do
      local paths_str="${COMPONENT_PATHS[$comp]}"
      IFS=: read -ra paths_arr <<< "$paths_str"
      for path in "${paths_arr[@]}"; do
        TRACKED_PATHS+=("$path")
      done
    done
  else
    # Filter by requested components
    IFS=',' read -ra COMPS <<< "$components_str"
    for comp in "${COMPS[@]}"; do
      comp="${comp// /}"  # trim spaces
      if [ -n "${COMPONENT_PATHS[$comp]:-}" ]; then
        local paths_str="${COMPONENT_PATHS[$comp]}"
        IFS=: read -ra paths_arr <<< "$paths_str"
        for path in "${paths_arr[@]}"; do
          TRACKED_PATHS+=("$path")
        done
      else
        echo "Warning: unknown component '$comp'" >&2
      fi
    done
  fi
}

# Initialize with all components (can be overridden by --components)
build_tracked_paths ""

mkdir -p "$PROFILES" "$BACKUPS" "$MANIFESTS"

usage() {
  cat <<'USAGE'
Usage:
  theme-profile status
  theme-profile list
  theme-profile save NAME [--components=comp1,comp2]
  theme-profile apply NAME [--components=comp1,comp2]
  theme-profile diff A B

Components: kwin, plasma_shell, kdeglobals, gtk3, gtk4, qt5ct,
            klassy, kvantum, alacritty, kitty, wofi, btop,
            fastfetch, zed, vscode, cursor, zen, obsidian,
            color_schemes, look_and_feel

Use --components=all for all (default).

Profiles live in $XDG_CONFIG_HOME/theme-profile/profiles
(default: ~/.config/theme-profile/profiles).
USAGE
}

# A single safe path component, shared by save/apply/diff.
valid_profile_name() {
  local name="${1:-}"
  [[ "$name" =~ ^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$ ]]
}

require_profile_name() {
  local name="${1:-}"
  if ! valid_profile_name "$name"; then
    echo "Invalid profile name: $name (must match [A-Za-z0-9][A-Za-z0-9._-]{0,63})" >&2
    exit 1
  fi
}

# Parse --components=... from args, sets global PARSED_COMPONENTS,
# PARSED_COMPONENTS_SET and PARSED_ARGS.  The flag distinguishes "not given"
# (all components) from an explicitly empty selection (an error).
parse_components_arg() {
  local args=("$@")
  PARSED_COMPONENTS=""
  PARSED_COMPONENTS_SET=0
  PARSED_ARGS=()

  for arg in "${args[@]}"; do
    if [[ "$arg" == --components=* ]]; then
      PARSED_COMPONENTS="${arg#--components=}"
      PARSED_COMPONENTS_SET=1
    else
      PARSED_ARGS+=("$arg")
    fi
  done
}

copy_tracked_into() {
  local target="$1"
  mkdir -p "$target" || return 1

  local rel src dst
  for rel in "${TRACKED_PATHS[@]}"; do
    src="$(live_path "$rel")"
    [ -e "$src" ] || continue
    dst="$target/$rel"
    mkdir -p "$(dirname "$dst")" || return 1
    if [ -e "$dst" ] || [ -L "$dst" ]; then
      rm -rf "$dst" || return 1
    fi
    cp -a "$src" "$dst" || {
      echo "Failed to copy $src -> $dst" >&2
      return 1
    }
  done
}

write_ini_group() {
  local file="$1"
  local group="$2"
  awk -v group="$group" '
    $0 == "[" group "]" { in_group=1; next }
    in_group && /^\[/ { exit }
    in_group { print }
  ' "$file" 2>/dev/null || true
}

capture_kde_effects_state() {
  local target="$1"
  local meta="$target/metadata/kde"
  local notification_server
  local kwin_support
  local kwin_active_effects
  local kwin_loaded_effects
  mkdir -p "$meta"

  notification_server="$(qdbus6 org.freedesktop.Notifications /org/freedesktop/Notifications org.freedesktop.Notifications.GetServerInformation 2>/dev/null || busctl --user call org.freedesktop.Notifications /org/freedesktop/Notifications org.freedesktop.Notifications GetServerInformation 2>/dev/null || true)"
  kwin_support="$(qdbus6 org.kde.KWin /KWin supportInformation 2>/dev/null || busctl --user call org.kde.KWin /KWin org.kde.KWin supportInformation 2>/dev/null || true)"
  kwin_active_effects="$(qdbus6 org.kde.KWin /Effects activeEffects 2>/dev/null || busctl --user call org.kde.KWin /Effects org.kde.kwin.Effects activeEffects 2>/dev/null || true)"
  kwin_loaded_effects="$(qdbus6 org.kde.KWin /Effects loadedEffects 2>/dev/null || busctl --user call org.kde.KWin /Effects org.kde.kwin.Effects loadedEffects 2>/dev/null || true)"

  {
    echo "Generated by theme-profile"
    echo "timestamp=$(date --iso-8601=seconds)"
    echo
    echo "[kwinrc: Plugins]"
    kreadconfig6 --file kwinrc --group Plugins --key glassEnabled 2>/dev/null | sed 's/^/glassEnabled=/' || true
    kreadconfig6 --file kwinrc --group Plugins --key blurEnabled 2>/dev/null | sed 's/^/blurEnabled=/' || true
    kreadconfig6 --file kwinrc --group Plugins --key better_blur_dxEnabled 2>/dev/null | sed 's/^/better_blur_dxEnabled=/' || true
    kreadconfig6 --file kwinrc --group Plugins --key contrastEnabled 2>/dev/null | sed 's/^/contrastEnabled=/' || true
    kreadconfig6 --file kwinrc --group Plugins --key translucencyEnabled 2>/dev/null | sed 's/^/translucencyEnabled=/' || true
    echo
    echo "[notification-server]"
    printf '%s\n' "$notification_server"
    echo
    echo "[kwin-dbus-active-effects]"
    printf '%s\n' "$kwin_active_effects"
    echo
    echo "[kwin-dbus-loaded-effects]"
    printf '%s\n' "$kwin_loaded_effects"
  } > "$meta/summary.txt"

  printf '%s\n' "$kwin_support" > "$meta/kwin-support-information.txt"
  kreadconfig6 --file kwinrc --group Plugins > "$meta/kwin-plugins.txt" 2>/dev/null || true

  {
    echo "[Effect-blur]"
    write_ini_group "$CONFIG_HOME/kwinrc" "Effect-blur"
    echo
    echo "[Effect-blurplus]"
    write_ini_group "$CONFIG_HOME/kwinrc" "Effect-blurplus"
    echo
    echo "[Effect-better-blur-dx]"
    write_ini_group "$CONFIG_HOME/kwinrc" "Effect-better-blur-dx"
    echo
    echo "[Effect-translucency]"
    write_ini_group "$CONFIG_HOME/kwinrc" "Effect-translucency"
  } > "$meta/glass-and-blur-config.txt"
}

restore_from_profile() {
  local profile="$1"
  local source="$PROFILES/$profile"
  [ -d "$source" ] || {
    echo "Profile not found: $profile" >&2
    exit 1
  }

  local rel src dst
  for rel in "${TRACKED_PATHS[@]}"; do
    src="$source/$rel"
    [ -e "$src" ] || continue
    dst="$(live_path "$rel")"
    mkdir -p "$(dirname "$dst")" || return 1
    if [ -d "$src" ]; then
      mkdir -p "$dst" || return 1
      cp -a "$src/." "$dst/" || {
        echo "Failed to restore $src -> $dst" >&2
        return 1
      }
    else
      cp -a "$src" "$dst" || {
        echo "Failed to restore $src -> $dst" >&2
        return 1
      }
    fi
  done

  (umask 077; printf '%s\n' "$profile" > "$ACTIVE_FILE")
  chmod 600 "$ACTIVE_FILE" 2>/dev/null || true
}

apply_live_hooks() {
  local profile="$1"
  local source="$PROFILES/$profile"
  local look_and_feel

  # Read the value FROM THE PROFILE, not from the live config. The previous
  # version passed the profile path as an extra positional argument, which made
  # kreadconfig6 print its --help text — and that text was then written into
  # kdeglobals as the LookAndFeelPackage name.
  look_and_feel="$(kreadconfig6 --file "$source/.config/kdeglobals" --group KDE --key LookAndFeelPackage 2>/dev/null || true)"
  if [ -n "$look_and_feel" ]; then
    kwriteconfig6 --file kdeglobals --group KDE --key LookAndFeelPackage "$look_and_feel" >/dev/null 2>&1 || true
  fi

  kbuildsycoca6 >/dev/null 2>&1 || true
  systemctl --user stop swaync.service >/dev/null 2>&1 || true
  qdbus6 org.kde.KWin /KWin reconfigure >/dev/null 2>&1 || true
  sync_kwin_effect "$source" glass
  sync_kwin_effect "$source" blur
  sync_kwin_effect "$source" contrast
  sync_kwin_effect "$source" better_blur_dx
  reconfigure_kwin_effect glass
  reconfigure_kwin_effect blur
  reconfigure_kwin_effect contrast
  reconfigure_kwin_effect better_blur_dx
  apply_kitty_live "$source"
  start_plasma_shell
}

reconfigure_kwin_effect() {
  qdbus6 org.kde.KWin /Effects reconfigureEffect "$1" >/dev/null 2>&1 || true
}

apply_kitty_live() {
  local source="$1"
  local config="$source/.config/kitty/kitty.conf"
  local opacity

  [ -f "$config" ] || return 0
  command -v kitty >/dev/null 2>&1 || return 0

  kitty @ --to unix:/tmp/kitty-theme-profile load-config "$config" >/dev/null 2>&1 || true

  opacity="$(awk '$1 == "background_opacity" { print $2; exit }' "$config" 2>/dev/null || true)"
  if [ -n "$opacity" ]; then
    kitty @ --to unix:/tmp/kitty-theme-profile set-background-opacity --all "$opacity" >/dev/null 2>&1 || true
  fi

  kitty @ --to unix:/tmp/kitty-theme-profile set-colors --all --configured "$config" >/dev/null 2>&1 || true
}

kwin_effect_key() {
  local group="$1"
  local key="$2"

  kreadconfig6 --file kwinrc --group "$group" --key "$key" 2>/dev/null | paste -sd, - || true
}

zen_user_pref() {
  local key="$1"
  local file="$HOME/.zen/gp0y8wrv.Default (release)/user.js"

  awk -v key="$key" '
    index($0, "user_pref(\"" key "\",") == 1 {
      value=$0
      sub("^user_pref\\(\"" key "\",[[:space:]]*", "", value)
      sub("\\);$", "", value)
      gsub(/^"|"$/, "", value)
      print value
      exit
    }
  ' "$file" 2>/dev/null || true
}

# Read a string member from a (possibly JSONC) settings file.
#   json_nested_value FILE OBJECT MEMBER
# e.g. json_nested_value ~/.config/zed/settings.json theme mode
# Trailing commas and comments are tolerated because we only look for the
# quoted key and strip everything around its value.
json_nested_value() {
  local file="$1" object="$2" member="$3"

  awk -v object="$object" -v member="$member" '
    $0 ~ "^[[:space:]]*\"" object "\"[[:space:]]*:" { in_object=1; next }
    in_object && /^[[:space:]]*}/ { exit }
    in_object && $0 ~ "^[[:space:]]*\"" member "\"[[:space:]]*:" {
      value=$0
      sub(/^[^:]*:[[:space:]]*"/, "", value)
      sub(/",?[[:space:]]*$/, "", value)
      print value
      exit
    }
  ' "$file" 2>/dev/null || true
}

# First string value of a top-level key in a JSON/JSONC settings file.
json_key_value() {
  local file="$1" key="$2"

  sed -n "s/.*\"${key}\"[[:space:]]*:[[:space:]]*\"\([^\"]*\)\".*/\1/p" "$file" 2>/dev/null | head -1
}

stop_plasma_shell_for_restore() {
  systemctl --user reset-failed plasma-plasmashell.service >/dev/null 2>&1 || true
  systemctl --user stop plasma-plasmashell.service >/dev/null 2>&1 || true
}

start_plasma_shell() {
  systemctl --user reset-failed plasma-plasmashell.service >/dev/null 2>&1 || true
  systemctl --user start plasma-plasmashell.service >/dev/null 2>&1 || true
  sleep 1
  if ! systemctl --user is-active --quiet plasma-plasmashell.service; then
    systemctl --user reset-failed plasma-plasmashell.service >/dev/null 2>&1 || true
    systemctl --user start plasma-plasmashell.service >/dev/null 2>&1 || true
  fi
}

sync_kwin_effect() {
  local source="$1"
  local effect="$2"
  local key="${effect}Enabled"
  local enabled

  enabled="$(awk -F= -v key="$key" '
    $0 == "[Plugins]" { in_group=1; next }
    in_group && /^\[/ { exit }
    in_group && $1 == key { print $2; exit }
  ' "$source/.config/kwinrc" 2>/dev/null || true)"

  case "$enabled" in
    true)
      qdbus6 org.kde.KWin /Effects loadEffect "$effect" >/dev/null 2>&1 || true
      ;;
    false)
      qdbus6 org.kde.KWin /Effects unloadEffect "$effect" >/dev/null 2>&1 || true
      ;;
  esac
}

write_manifest() {
  local target="$1"
  {
    echo "Generated by theme-profile"
    echo "timestamp=$(date --iso-8601=seconds)"
    echo "user=$USER"
    echo
    echo "[tracked]"
    printf '%s\n' "${TRACKED_PATHS[@]}"
  } > "$target/manifest.txt"
}

status() {
  echo "active_profile=$(cat "$ACTIVE_FILE" 2>/dev/null || echo unknown)"
  echo "kde_color_scheme=$(kreadconfig6 --file kdeglobals --group General --key ColorScheme 2>/dev/null || true)"
  echo "kde_accent=$(kreadconfig6 --file kdeglobals --group General --key AccentColor 2>/dev/null || true)"
  echo "kde_look_and_feel=$(kreadconfig6 --file kdeglobals --group KDE --key LookAndFeelPackage 2>/dev/null || true)"
  echo "kde_widget_style=$(kreadconfig6 --file kdeglobals --group KDE --key widgetStyle 2>/dev/null || true)"
  echo "kwin_glass=$(kreadconfig6 --file kwinrc --group Plugins --key glassEnabled 2>/dev/null || true)"
  echo "kwin_blur=$(kreadconfig6 --file kwinrc --group Plugins --key blurEnabled 2>/dev/null || true)"
  echo "kwin_contrast=$(kreadconfig6 --file kwinrc --group Plugins --key contrastEnabled 2>/dev/null || true)"
  echo "kwin_better_blur_dx=$(kreadconfig6 --file kwinrc --group Plugins --key better_blur_dxEnabled 2>/dev/null || true)"
  echo "bbdx_blur_strength=$(kwin_effect_key Effect-better-blur-dx BlurStrength)"
  echo "bbdx_contrast=$(kwin_effect_key Effect-better-blur-dx Contrast)"
  echo "bbdx_blur_decorations=$(kwin_effect_key Effect-better-blur-dx BlurDecorations)"
  echo "bbdx_blur_docks=$(kwin_effect_key Effect-better-blur-dx BlurDocks)"
  echo "bbdx_blur_menus=$(kwin_effect_key Effect-better-blur-dx BlurMenus)"
  echo "bbdx_refraction_strength=$(kwin_effect_key Effect-better-blur-dx RefractionStrength)"
  echo "bbdx_refraction_edge_size=$(kwin_effect_key Effect-better-blur-dx RefractionEdgeSize)"
  echo "bbdx_refraction_normal_pow=$(kwin_effect_key Effect-better-blur-dx RefractionNormalPow)"
  echo "bbdx_window_classes=$(kwin_effect_key Effect-better-blur-dx WindowClasses)"
  echo "kwin_translucency_inactive=$(kreadconfig6 --file kwinrc --group Effect-translucency --key Inactive 2>/dev/null || true)"
  echo "kvantum_theme=$(sed -n 's/^theme=//p' "$CONFIG_HOME/Kvantum/kvantum.kvconfig" 2>/dev/null || true)"
  echo "gtk3_theme=$(sed -n 's/^gtk-theme-name=//p' "$CONFIG_HOME/gtk-3.0/settings.ini" 2>/dev/null || true)"
  echo "gtk3_prefer_dark=$(sed -n 's/^gtk-application-prefer-dark-theme=//p' "$CONFIG_HOME/gtk-3.0/settings.ini" 2>/dev/null || true)"
  echo "klassy_titlebar_active_opacity=$(kreadconfig6 --file "$CONFIG_HOME/klassy/klassyrc" --group TitleBarOpacity --key ActiveTitleBarOpacity 2>/dev/null || true)"
  echo "klassy_titlebar_inactive_opacity=$(kreadconfig6 --file "$CONFIG_HOME/klassy/klassyrc" --group TitleBarOpacity --key InactiveTitleBarOpacity 2>/dev/null || true)"
  echo "klassy_corner_radius=$(kreadconfig6 --file "$CONFIG_HOME/klassy/klassyrc" --group Windeco --key WindowCornerRadius 2>/dev/null || true)"
  echo "alacritty_opacity=$(sed -n 's/^opacity = //p' "$CONFIG_HOME/alacritty/alacritty.toml" 2>/dev/null || true)"
  echo "alacritty_blur=$(sed -n 's/^blur = //p' "$CONFIG_HOME/alacritty/alacritty.toml" 2>/dev/null || true)"
  echo "kitty_background_opacity=$(sed -n 's/^background_opacity //p' "$CONFIG_HOME/kitty/kitty.conf" 2>/dev/null || true)"
  echo "kitty_background_blur=$(sed -n 's/^background_blur //p' "$CONFIG_HOME/kitty/kitty.conf" 2>/dev/null || true)"
  echo "zen_transparent_browser=$(zen_user_pref browser.tabs.allow_transparent_browser)"
  echo "zen_linux_transparency=$(zen_user_pref zen.widget.linux.transparency)"
  echo "zen_custom_stylesheets=$(zen_user_pref toolkit.legacyUserProfileCustomizations.stylesheets)"
  echo "zen_active_theme=$(zen_user_pref extensions.activeThemeID)"
  echo "zen_content_theme=$(zen_user_pref browser.theme.content-theme)"
  echo "zen_toolbar_theme=$(zen_user_pref browser.theme.toolbar-theme)"
  echo "zen_transparency_color=$(zen_user_pref mod.sameerasw.zen_transparency_color)"
  echo "zen_bg_color_enabled=$(zen_user_pref mod.sameerasw.zen_bg_color_enabled)"
  echo "zen_bg_opacity=$(zen_user_pref mod.sameerasw.zen_bg_opacity)"
  echo "btop_rounded_corners=$(sed -n 's/^rounded_corners = //p' "$CONFIG_HOME/btop/btop.conf" 2>/dev/null || true)"
  echo "zed_theme_mode=$(json_nested_value "$CONFIG_HOME/zed/settings.json" theme mode)"
  echo "zed_theme_light=$(json_nested_value "$CONFIG_HOME/zed/settings.json" theme light)"
  echo "zed_theme_dark=$(json_nested_value "$CONFIG_HOME/zed/settings.json" theme dark)"
  echo "code_theme=$(json_key_value "$CONFIG_HOME/Code/User/settings.json" workbench.colorTheme)"
  echo "cursor_theme=$(json_key_value "$CONFIG_HOME/Cursor/User/settings.json" workbench.colorTheme)"
  obsidian_appearance="$(tr -d '\n' < "$HOME/obsidian/vault/.obsidian/appearance.json" 2>/dev/null || true)"
  if [ "$obsidian_appearance" = "{}" ]; then
    obsidian_appearance=""
  fi
  echo "obsidian_appearance=$obsidian_appearance"
}

cmd="${1:-}"
case "$cmd" in
  status)
    status
    ;;
  list)
    find "$PROFILES" -mindepth 1 -maxdepth 1 -type d -printf '%f\n' | sort
    ;;
  save)
    parse_components_arg "${@:2}"
    name="${PARSED_ARGS[0]:-}"
    [ -n "$name" ] || {
      usage >&2
      exit 1
    }
    require_profile_name "$name"
    [ "${#PARSED_ARGS[@]}" -eq 1 ] || { echo "Expected exactly one profile name" >&2; exit 1; }
    if [ "$PARSED_COMPONENTS_SET" -eq 1 ] && [ -z "$PARSED_COMPONENTS" ]; then
      echo "No components selected" >&2
      exit 1
    fi
    build_tracked_paths "$PARSED_COMPONENTS"
    [ "${#TRACKED_PATHS[@]}" -gt 0 ] || { echo "No valid components selected" >&2; exit 1; }

    target="$PROFILES/$name"
    # Build the new snapshot in a temporary directory and swap it in only
    # after every copy succeeded.  Re-saving an existing profile therefore
    # cannot leave files from the previous component set behind.
    tmp="$(mktemp -d "$PROFILES/.save-$name-XXXXXX")" || exit 1
    if ! { copy_tracked_into "$tmp" && capture_kde_effects_state "$tmp" && write_manifest "$tmp"; }; then
      rm -rf "$tmp"
      echo "Failed to save profile: $name" >&2
      exit 1
    fi

    backup=""
    if [ -e "$target" ] || [ -L "$target" ]; then
      backup="$(mktemp -d "$BACKUPS/pre-save-$name-XXXXXX")" || { rm -rf "$tmp"; exit 1; }
      rmdir "$backup"
      if ! mv "$target" "$backup"; then
        rm -rf "$tmp"
        echo "Failed to move the previous profile to $backup" >&2
        exit 1
      fi
    fi
    if ! mv "$tmp" "$target"; then
      rm -rf "$tmp"
      [ -z "$backup" ] || mv "$backup" "$target"
      echo "Failed to activate the new profile snapshot: $name" >&2
      exit 1
    fi
    (umask 077; printf '%s\n' "$name" > "$ACTIVE_FILE")
    chmod 600 "$ACTIVE_FILE" 2>/dev/null || true
    echo "Saved profile: $name${PARSED_COMPONENTS:+ (components: $PARSED_COMPONENTS)}"
    ;;
  apply)
    parse_components_arg "${@:2}"
    name="${PARSED_ARGS[0]:-}"
    [ -n "$name" ] || {
      usage >&2
      exit 1
    }
    require_profile_name "$name"
    [ "${#PARSED_ARGS[@]}" -eq 1 ] || { echo "Expected exactly one profile name" >&2; exit 1; }
    if [ "$PARSED_COMPONENTS_SET" -eq 1 ] && [ -z "$PARSED_COMPONENTS" ]; then
      echo "No components selected" >&2
      exit 1
    fi
    # ВАЖНО: проверяем профиль ДО остановки plasma
    [ -d "$PROFILES/$name" ] || { echo "Profile not found: $name" >&2; exit 1; }
    # Rebuild TRACKED_PATHS с выбранными компонентами
    build_tracked_paths "$PARSED_COMPONENTS"
    [ "${#TRACKED_PATHS[@]}" -gt 0 ] || { echo "No valid components selected" >&2; exit 1; }
    backup="$(mktemp -d "$BACKUPS/pre-apply-$name-XXXXXX")" || exit 1
    if ! { copy_tracked_into "$backup" && capture_kde_effects_state "$backup" && write_manifest "$backup"; }; then
      rm -rf "$backup"
      echo "Failed to create pre-apply backup" >&2
      exit 1
    fi
    # trap: если что-то упадёт после остановки — вернём plasma
    trap 'start_plasma_shell' ERR
    stop_plasma_shell_for_restore
    if restore_from_profile "$name"; then
      apply_live_hooks "$name"
      trap - ERR
      echo "Applied profile: $name${PARSED_COMPONENTS:+ (components: $PARSED_COMPONENTS)}"
      echo "Pre-apply backup: $backup"
    else
      start_plasma_shell
      trap - ERR
      echo "Failed to apply profile: $name — plasma shell started, pre-apply backup: $backup" >&2
      exit 1
    fi
    ;;
  diff)
    a="${2:-}"
    b="${3:-}"
    [ -n "$a" ] && [ -n "$b" ] || {
      usage >&2
      exit 1
    }
    require_profile_name "$a"
    require_profile_name "$b"
    [ -d "$PROFILES/$a" ] || { echo "Profile not found: $a" >&2; exit 1; }
    [ -d "$PROFILES/$b" ] || { echo "Profile not found: $b" >&2; exit 1; }
    # `set -e` is active, so capture the exit status with `|| rc=$?`:
    # plain `diff -ru ...; rc=$?` aborts the script on the first difference
    # (diff exits 1), which made callers report a bogus error instead of the diff.
    rc=0
    diff -ru -- "$PROFILES/$a" "$PROFILES/$b" || rc=$?
    if [ "$rc" -eq 1 ]; then
      # differences found — this is normal
      exit 0
    elif [ "$rc" -ne 0 ]; then
      exit "$rc"
    fi
    ;;
  --help|-h)
    usage
    exit 0
    ;;
  *)
    usage
    exit 1
    ;;
esac
